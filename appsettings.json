{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "AgentId": "fs01-office",
    "Site": "office",
    "ApiBaseUrl": "https://monitor.example.com",
    "ApiKeyEnvironmentVariable": "MONITOR_AGENT_API_KEY",
    "DataDirectory": "C:\\ProgramData\\OfficeMonitoringAgent",
    "BatchSize": 200,
    "SendIntervalSeconds": 15,
    "HeartbeatIntervalSeconds": 60,
    "FileEventDebounceSeconds": 3,
    "Folders": [
      {
        "Code": "finance",
        "Name": "Keuangan",
        "Path": "D:\\Shared\\Keuangan"
      },
      {
        "Code": "investment",
        "Name": "Investasi",
        "Path": "D:\\Shared\\Investasi"
      },
      {
        "Code": "pension",
        "Name": "Kepesertaan",
        "Path": "D:\\Shared\\Kepesertaan"
      },
      {
        "Code": "letters",
        "Name": "Persuratan",
        "Path": "D:\\Shared\\Persuratan"
      },
      {
        "Code": "board",
        "Name": "Direksi",
        "Path": "D:\\Shared\\Direksi"
      }
    ],
    "Dfsr": {
      "Enabled": false,
      "IntervalSeconds": 60,
      "CommandTimeoutSeconds": 90,
      "Routes": [
        {
          "Code": "finance-out",
          "GroupName": "RG-OFFICE",
          "FolderName": "Keuangan",
          "SourceComputer": "FS-KANTOR",
          "DestinationComputer": "FS-DC"
        },
        {
          "Code": "finance-in",
          "GroupName": "RG-OFFICE",
          "FolderName": "Keuangan",
          "SourceComputer": "FS-DC",
          "DestinationComputer": "FS-KANTOR"
        }
      ]
    }
  }
}