{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "AgentId": "fs01-office",
    "Site": "office",
    "ApiBaseUrl": "https://monitor.example.com",
    "ApiKeyEnvironmentVariable": "MONITOR_AGENT_API_KEY",
    "DataDirectory": "C:\\ProgramData\\OfficeMonitoringAgent",
    "BatchSize": 200,
    "SendIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 30,
    "FileEventDebounceSeconds": 3,
    "FolderCheckSeconds": 30,
    "MaxReconcileEvents": 5000,
    "Folders": [
      {
        "Code": "finance",
        "Name": "Keuangan",
        "Path": "D:\\Shared\\Keuangan"
      },
      {
        "Code": "investment",
        "Name": "Investasi",
        "Path": "D:\\Shared\\Investasi"
      },
      {
        "Code": "pension",
        "Name": "Kepesertaan",
        "Path": "D:\\Shared\\Kepesertaan"
      },
      {
        "Code": "letters",
        "Name": "Persuratan",
        "Path": "D:\\Shared\\Persuratan"
      },
      {
        "Code": "board",
        "Name": "Direksi",
        "Path": "D:\\Shared\\Direksi"
      }
    ],
    "Dfsr": {
      "Enabled": false,
      "IntervalSeconds": 60,
      "CommandTimeoutSeconds": 90,
      "Routes": [
        {
          "Code": "finance-out",
          "GroupName": "RG-OFFICE",
          "FolderName": "Keuangan",
          "SourceComputer": "FS-KANTOR",
          "DestinationComputer": "FS-DC"
        },
        {
          "Code": "finance-in",
          "GroupName": "RG-OFFICE",
          "FolderName": "Keuangan",
          "SourceComputer": "FS-DC",
          "DestinationComputer": "FS-KANTOR"
        }
      ]
    },
    "Syncthing": {
      "Enabled": false,
      "BaseUrl": "https://127.0.0.1:8384",
      "ApiKeyEnvironmentVariable": "SYNCTHING_API_KEY",
      "IntervalSeconds": 15,
      "RequireTailscale": true,
      "Routes": [
        {
          "Code": "finance-dc",
          "FolderId": "keuangan",
          "FolderLabel": "Keuangan",
          "RemoteDeviceId": "REPLACE-WITH-REMOTE-SYNCTHING-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        }
      ]
    },
    "Tailscale": {
      "Enabled": false,
      "ExePath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      "IntervalSeconds": 30,
      "PingTimeoutSeconds": 5,
      "Peers": [
        {
          "Code": "dc",
          "HostName": "fs-dc"
        }
      ]
    },
    "Parity": {
      "Enabled": false,
      "IntervalSeconds": 900,
      "BucketDepth": 2,
      "MaxBuckets": 1000,
      "ContentSampleFiles": 20,
      "ContentSampleMaxFileBytes": 104857600,
      "Exclude": []
    }
  }
}
