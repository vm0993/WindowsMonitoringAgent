{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "AgentId": "fs-mirror",
    "Site": "office",
    "ApiBaseUrl": "https://TAILSCALE-IP",
    "RequireTailscaleApi": true,
    "ApiKeyEnvironmentVariable": "MONITOR_AGENT_API_KEY",
    "DataDirectory": "C:\\ProgramData\\OfficeMonitoringAgent",
    "BatchSize": 200,
    "SendIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 30,
    "FileEventDebounceSeconds": 3,
    "FolderCheckSeconds": 30,
    "MaxReconcileEvents": 5000,
    "Folders": [
      {
        "Code": "umum",
        "Name": "umum",
        "Path": "D:\\umum"
      },
      {
        "Code": "dirut",
        "Name": "dirut",
        "Path": "D:\\dirut"
      },
      {
        "Code": "sekum",
        "Name": "sekum",
        "Path": "D:\\sekum"
      },
      {
        "Code": "iuran",
        "Name": "iuran",
        "Path": "D:\\iuran"
      },
      {
        "Code": "keuangan",
        "Name": "keuangan",
        "Path": "D:\\keuangan"
      },
      {
        "Code": "managemen",
        "Name": "managemen",
        "Path": "D:\\managemen"
      },
      {
        "Code": "fungsi-komite",
        "Name": "fungsi&komite",
        "Path": "D:\\fungsi&komite"
      },
      {
        "Code": "kepesertaan",
        "Name": "Public Kepesertaan",
        "Path": "D:\\Public Kepesertaan"
      },
      {
        "Code": "investasi",
        "Name": "Public Investasi",
        "Path": "D:\\Public Investasi"
      },
      {
        "Code": "sekretariat-umum",
        "Name": "Sekretariat&umum",
        "Path": "D:\\Sekretariat&umum"
      }
    ],
    "Dfsr": {
      "Enabled": false,
      "IntervalSeconds": 60,
      "CommandTimeoutSeconds": 90,
      "Routes": []
    },
    "Syncthing": {
      "Enabled": true,
      "BaseUrl": "https://127.0.0.1:8384",
      "ApiKeyEnvironmentVariable": "SYNCTHING_API_KEY",
      "IntervalSeconds": 15,
      "RequireTailscale": true,
      "Routes": [
        {
          "Code": "umum-mirror-dc",
          "FolderId": "umum",
          "FolderLabel": "umum",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "dirut-mirror-dc",
          "FolderId": "dirut",
          "FolderLabel": "dirut",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "sekum-mirror-dc",
          "FolderId": "sekum",
          "FolderLabel": "sekum",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "iuran-mirror-dc",
          "FolderId": "iuran",
          "FolderLabel": "iuran",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "finance-mirror-dc",
          "FolderId": "keuangan",
          "FolderLabel": "keuangan",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "managemen-mirror-dc",
          "FolderId": "managemen",
          "FolderLabel": "managemen",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "fungsi-komite-mirror-dc",
          "FolderId": "fungsi-komite",
          "FolderLabel": "fungsi&komite",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "kepesertaan-mirror-dc",
          "FolderId": "kepesertaan",
          "FolderLabel": "Public Kepesertaan",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "investasi-mirror-dc",
          "FolderId": "investasi",
          "FolderLabel": "Public Investasi",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        },
        {
          "Code": "sekretariat-umum-mirror-dc",
          "FolderId": "sekretariat-umum",
          "FolderLabel": "Sekretariat&umum",
          "RemoteDeviceId": "REPLACE-WITH-FS-DC-DEVICE-ID",
          "RemoteName": "FS-DC",
          "ExpectedFolderType": "sendonly"
        }
      ]
    },
    "Tailscale": {
      "Enabled": true,
      "ExePath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      "IntervalSeconds": 30,
      "PingTimeoutSeconds": 5,
      "Peers": [
        {
          "Code": "dc",
          "HostName": "fs-dc"
        }
      ]
    },
    "Parity": {
      "Enabled": true,
      "IntervalSeconds": 900,
      "BucketDepth": 2,
      "MaxBuckets": 1000,
      "ContentSampleFiles": 20,
      "ContentSampleMaxFileBytes": 104857600,
      "Exclude": []
    }
  }
}
