{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "AgentId": "fs-utama",
    "Site": "office",
    "ApiBaseUrl": "https://monitor.example.com",
    "ApiKeyEnvironmentVariable": "MONITOR_AGENT_API_KEY",
    "DataDirectory": "C:\\ProgramData\\OfficeMonitoringAgent",
    "BatchSize": 200,
    "SendIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 30,
    "FileEventDebounceSeconds": 3,
    "FolderCheckSeconds": 30,
    "MaxReconcileEvents": 5000,
    "Folders": [
      {
        "Code": "finance",
        "Name": "Keuangan",
        "Path": "D:\\Shared\\Keuangan"
      },
      {
        "Code": "investment",
        "Name": "Investasi",
        "Path": "D:\\Shared\\Investasi"
      },
      {
        "Code": "pension",
        "Name": "Kepesertaan",
        "Path": "D:\\Shared\\Kepesertaan"
      },
      {
        "Code": "letters",
        "Name": "Persuratan",
        "Path": "D:\\Shared\\Persuratan"
      },
      {
        "Code": "board",
        "Name": "Direksi",
        "Path": "D:\\Shared\\Direksi"
      }
    ],
    "Dfsr": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "CommandTimeoutSeconds": 90,
      "Routes": [
        {
          "Code": "finance-utama-mirror",
          "GroupName": "RG-MIRROR",
          "FolderName": "Keuangan",
          "SourceComputer": "FS-UTAMA",
          "DestinationComputer": "FS-MIRROR"
        },
        {
          "Code": "finance-mirror-utama",
          "GroupName": "RG-MIRROR",
          "FolderName": "Keuangan",
          "SourceComputer": "FS-MIRROR",
          "DestinationComputer": "FS-UTAMA"
        },
        {
          "Code": "investment-utama-mirror",
          "GroupName": "RG-MIRROR",
          "FolderName": "Investasi",
          "SourceComputer": "FS-UTAMA",
          "DestinationComputer": "FS-MIRROR"
        },
        {
          "Code": "investment-mirror-utama",
          "GroupName": "RG-MIRROR",
          "FolderName": "Investasi",
          "SourceComputer": "FS-MIRROR",
          "DestinationComputer": "FS-UTAMA"
        },
        {
          "Code": "pension-utama-mirror",
          "GroupName": "RG-MIRROR",
          "FolderName": "Kepesertaan",
          "SourceComputer": "FS-UTAMA",
          "DestinationComputer": "FS-MIRROR"
        },
        {
          "Code": "pension-mirror-utama",
          "GroupName": "RG-MIRROR",
          "FolderName": "Kepesertaan",
          "SourceComputer": "FS-MIRROR",
          "DestinationComputer": "FS-UTAMA"
        },
        {
          "Code": "letters-utama-mirror",
          "GroupName": "RG-MIRROR",
          "FolderName": "Persuratan",
          "SourceComputer": "FS-UTAMA",
          "DestinationComputer": "FS-MIRROR"
        },
        {
          "Code": "letters-mirror-utama",
          "GroupName": "RG-MIRROR",
          "FolderName": "Persuratan",
          "SourceComputer": "FS-MIRROR",
          "DestinationComputer": "FS-UTAMA"
        },
        {
          "Code": "board-utama-mirror",
          "GroupName": "RG-MIRROR",
          "FolderName": "Direksi",
          "SourceComputer": "FS-UTAMA",
          "DestinationComputer": "FS-MIRROR"
        },
        {
          "Code": "board-mirror-utama",
          "GroupName": "RG-MIRROR",
          "FolderName": "Direksi",
          "SourceComputer": "FS-MIRROR",
          "DestinationComputer": "FS-UTAMA"
        }
      ]
    },
    "Syncthing": {
      "Enabled": false,
      "BaseUrl": "https://127.0.0.1:8384",
      "ApiKeyEnvironmentVariable": "SYNCTHING_API_KEY",
      "IntervalSeconds": 15,
      "RequireTailscale": true,
      "Routes": []
    },
    "Tailscale": {
      "Enabled": false,
      "ExePath": "C:\\Program Files\\Tailscale\\tailscale.exe",
      "IntervalSeconds": 30,
      "PingTimeoutSeconds": 5,
      "Peers": []
    },
    "Parity": {
      "Enabled": true,
      "IntervalSeconds": 900,
      "BucketDepth": 2,
      "MaxBuckets": 1000,
      "ContentSampleFiles": 20,
      "ContentSampleMaxFileBytes": 104857600,
      "Exclude": []
    }
  }
}
